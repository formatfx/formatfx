{
  "id": "to-do",
  "kind": "row",
  "source": "view-samples/to-do/to-do.json",
  "screenshot": "view-samples/to-do/assets/screenshot.png",
  "notes": "Microsoft To Do lookalike (right pane of the screenshot): each row is a bordered line with a CircleRing/SkypeCircleCheck toggle, the title (struck through when Status is true), then a small date line — red 'Overdue, <Date>' for past dues, blue 'Today' for today's, plain 'Due, <Date>' for future — plus QuickNote/Tag/Attach icon segments, a comment icon (filled themePrimary when _CommentCount > 0), and a star (filled when Important). Groups render via groupProps as 'To Do - 3 items' / 'Completed - 2 items' pills (grouped by Status). The [$Date] column is SharePoint-calculated display text (kept as a text field so 'Overdue, Mon, December 27, 2021' matches the screenshot); 'File estimated quarterly taxes' gets a future Duedate (2028-01-11) to stay on the 'Due' side of @now while its Date text matches the screenshot's 2022 label. Hover card user photos (getUserImage) cannot load offline.",
  "fields": [
    { "name": "Title", "type": "text" },
    { "name": "Description", "type": "note" },
    { "name": "Category", "type": "choice", "choices": ["Blue", "Green", "Red", "Yellow"] },
    { "name": "Duedate", "type": "date", "displayName": "Due date" },
    { "name": "Important", "type": "boolean" },
    { "name": "Status", "type": "boolean" },
    { "name": "Date", "type": "text" },
    { "name": "_CommentCount", "type": "number" },
    { "name": "Attachments", "type": "boolean" },
    { "name": "Author", "type": "person" },
    { "name": "Editor", "type": "person" },
    { "name": "Created", "type": "date" },
    { "name": "Modified", "type": "date" }
  ],
  "rows": [
