{
  "id": "alternating-rows",
  "kind": "row",
  "source": "view-samples/alternating-rows/alternating-rows.json",
  "screenshot": "view-samples/alternating-rows/assets/screenshot.png",
  "notes": "Even @rowIndex rows (0, 2, 4, 6 → visual rows 1, 3, 5, 7) get the ms-bgColor-themeLighter tint (light blue in the default theme); odd rows stay untinted. Tinting must follow @rowIndex, not item data, so it survives sorting/filtering.",
  "fields": [
    { "name": "Title", "type": "text" },
    { "name": "MyChoice", "type": "choice", "choices": ["Choice 1", "Choice 2", "Choice 3"] }
  ],
  "rows": [
    { "Title": "Row 1", "MyChoice": "Choice 3" },
    { "Title": "Row 2", "MyChoice": "Choice 2" },
    { "Title": "Row 3", "MyChoice": "Choice 2" },
    { "Title": "Row 4", "MyChoice": "Choice 2" },
    { "Title": "Row 5", "MyChoice": "Choice 1" },
    { "Title": "Row 6", "MyChoice": "Choice 1" },
    { "Title": "Row 7", "MyChoice": "Choice 3" },
    { "Title": "Row 8", "MyChoice": "Choice 1" }
  ],
  "formatter": {
    "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
    "additionalRowClass": "=if(@rowIndex % 2 == 0,'ms-bgColor-themeLighter ms-bgColor-themeLight--hover','')"
  }
}
